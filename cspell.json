{
  "version": "0.2",
  "language": "en",
  "ignoreRegExpList": [
    "/[\\u0400-\\u04FF]+/g"
  ],
  "words": [
    "screan",
    "cooldown",
    "Kabdrashev",
    "ncvrngksvjteeigp",
    "syncfusion",
    "dotenv",
    "shelf",
    "bcrypt",
    "scram",
    "postgres",
    "datname",
    "databasename"
  ],
  "ignorePaths": [
